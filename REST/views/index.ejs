<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="index.css" />
    <title>Blog Page</title>
  </head>
  <body>
    <h1 class="heading">Qura POST</h1>

    <div class="cont">
      <% for(post of posts){ %>
      <div class="posts">
        <h3><%= post.username %></h3>
        <p><%= post.content %></p>
      </div>
      <% } %>

      
      <a href="http://localhost:3000/posts/new">Add new post</a>
    </div>
  </body>
</html>
