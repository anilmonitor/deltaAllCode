<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="index.css" />
    <title>Blog Page</title>
  </head>
  <body>
    <h1 class="heading">Quora POST</h1>

  

     <% posts.forEach((post, index) =>{ %>
 <div class="posts">
  <h3>Post id: <%=post.id %> </h3>
        <h3><%= post.username %></h3>
        <p><%= post.content %></p>
        <img src="<%=post.photo%>">
        <a href="http://localhost:3000/posts/<%= post.id %>">View Post</a>
       <a href="http://localhost:3000/posts/<%= post.id %>/edit">Edit</a>
         <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
      <button>Delete resource</button>
    </form>
      </div>
     <% }) %>

      <a href="http://localhost:3000/posts/new">Add new post</a>
    </div>
  </body>
</html>
