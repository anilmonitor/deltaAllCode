<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Wikipedia Card</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background-color: #f2f2f2;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
      }

      .card {
        background-color: #ffffff;
        width: 320px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s;
      }

      .card:hover {
        transform: translateY(-8px);
      }

      .card img {
        width: 100%;
        height: 180px;
        object-fit: contain;
        background-color: #f9f9f9;
      }

      .card-content {
        padding: 16px;
      }

      .card-content h2 {
        margin: 0 0 10px;
        color: #333;
      }

      .card-content p {
        font-size: 14px;
        color: #555;
        line-height: 1.5;
      }

      .card-content a {
        display: inline-block;
        margin-top: 12px;
        text-decoration: none;
        background-color: #007bff;
        color: white;
        padding: 8px 14px;
        border-radius: 6px;
        font-size: 14px;
      }

      .card-content a:hover {
        background-color: #0056b3;
      }

      h4 {
        background-color: black;
        color: white;
        padding: 0.2rem;
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <img
        src="https://upload.wikimedia.org/wikipedia/commons/a/a7/React-icon.svg"
        alt="React Logo"
      />

      <div class="card-content">
        <h2>React</h2>
        <h4>
          My name is <%= details.Name %> n I am <%= details.age %> year old.
        </h4>
        <p>
          React is a JavaScript library for building user interfaces. It is
          maintained by Meta and widely used for web applications.
        </p>

        <a
          href="https://en.wikipedia.org/wiki/React_(software)"
          target="_blank"
        >
          Read More
        </a>
      </div>
    </div>
  </body>
</html>
